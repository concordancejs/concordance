{
  "name": "concordance",
  "version": "5.0.4",
  "description": "Compare, format, diff and serialize any JavaScript value",
  "type": "module",
  "exports": "./dist/exports.js",
  "files": [
    "dist",
    "!dist/*.test.js",
    "src",
    "!src/*.test.ts"
  ],
  "engines": {
    "node": ">=22.14 || >=23.8"
  },
  "scripts": {
    "build": "rm -rf dist && tsc",
    "test": "prettier --check . && xo && tsc --noEmit && c8 ava"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/concordancejs/concordance.git"
  },
  "author": "Mark Wubben (https://novemberborn.net/)",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/concordancejs/concordance/issues"
  },
  "homepage": "https://github.com/concordancejs/concordance#readme",
  "devDependencies": {
    "@sindresorhus/tsconfig": "^7.0.0",
    "ava": "^6.2.0",
    "c8": "^10.1.3",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3",
    "xo": "^0.60.0"
  },
  "dependencies": {
    "never": "^1.1.0"
  },
  "overrides": {
    "xo": {
      "@typescript-eslint/parser": "^8",
      "typescript": "^5.8.1-rc"
    }
  },
  "volta": {
    "node": "22.14.0",
    "npm": "11.3.0"
  }
}
