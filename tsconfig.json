{
  "extends": "@sindresorhus/tsconfig",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "module": "nodenext",
    "outDir": "dist",
    "rewriteRelativeImportExtensions": true,
    "erasableSyntaxOnly": true,
    "types": ["node"],
    "lib": ["esnext"],
    "target": "es2024",
    "verbatimModuleSyntax": true
  }
}
